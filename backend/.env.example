# Deployment: copy to backend/.env for local development.
# On Render, set these in the service Environment Variables dashboard.

# Database (local dev uses SQLite by default)
DATABASE_URL=sqlite:///./crm.db

# Production example (Render Postgres — auto-set when using render.yaml)
# DATABASE_URL=postgresql://crm_user:password@host:5432/crm_db

# Groq API key (required for AI features)
GROQ_API_KEY=your_groq_api_key_here

# CORS: comma-separated frontend origins allowed to call this API.
# Use * for local development; set your Vercel URL in production.
CORS_ORIGINS=*

# Production example
# CORS_ORIGINS=https://your-frontend.vercel.app
